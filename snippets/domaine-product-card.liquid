{%- doc -%}
  Domaine product card snippet.

  Renders the Figma-driven card markup in an isolated `.dm-scope` wrapper so
  Tailwind utilities (compiled with the `dm-` prefix) never collide with
  Horizon's global styles. All variant-shape data the custom element needs at
  runtime is embedded in a single `data-product` attribute so the JS side can
  swap imagery, pricing, and the sale badge without an extra fetch.

  @param {object} product - The product object to render
  @param {object} [block] - Optional block reference for Shopify editor attributes
{%- enddoc -%}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign primary_image = current_variant.featured_image | default: product.featured_image
  assign hover_image = current_variant.metafields.custom.hover_image.value | default: primary_image

  assign on_sale = false
  if current_variant.compare_at_price != blank and current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif

  assign variant_url = product.url | append: '?variant=' | append: current_variant.id
  assign brand_label = product.vendor
%}

{%- capture product_json -%}
{
  "id": {{ product.id }},
  "url": {{ product.url | json }},
  "variants": [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "url": {{ product.url | append: '?variant=' | append: variant.id | json }},
        "available": {{ variant.available }},
        "price": {{ variant.price }},
        "compare_at_price": {% if variant.compare_at_price %}{{ variant.compare_at_price }}{% else %}null{% endif %},
        "option1": {{ variant.option1 | json }},
        "option2": {{ variant.option2 | json }},
        "option3": {{ variant.option3 | json }},
        "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
        "hover_image": {% if variant.metafields.custom.hover_image.value %}{{ variant.metafields.custom.hover_image.value | image_url: width: 800 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}

<domaine-product-card
  class="dm-scope"
  data-product-id="{{ product.id }}"
  data-product="{{ product_json | strip_newlines | escape }}"
  {% if block %}{{ block.shopify_attributes }}{% endif %}
>
  <a
    href="{{ variant_url }}"
    class="dm-group dm-relative dm-block dm-aspect-[315/340] dm-overflow-hidden dm-rounded-[10px] dm-border dm-border-hairline dm-bg-white"
    data-card-link
    aria-label="{{ product.title | escape }}"
  >
    <div class="dm-absolute dm-inset-[20px]">
      {% if primary_image != blank %}
        <img
          src="{{ primary_image | image_url: width: 800 }}"
          alt="{{ primary_image.alt | default: product.title | escape }}"
          width="{{ primary_image.width }}"
          height="{{ primary_image.height }}"
          loading="lazy"
          class="dm-absolute dm-inset-0 dm-h-full dm-w-full dm-object-contain dm-transition-opacity dm-duration-300"
          data-primary-image
        >
      {% endif %}

      {% if hover_image != blank and hover_image != primary_image %}
        <img
          src="{{ hover_image | image_url: width: 800 }}"
          alt=""
          aria-hidden="true"
          width="{{ hover_image.width }}"
          height="{{ hover_image.height }}"
          loading="lazy"
          class="dm-absolute dm-inset-0 dm-h-full dm-w-full dm-object-contain dm-opacity-0 dm-transition-opacity dm-duration-300 group-hover:dm-opacity-100"
          data-hover-image
        >
      {% endif %}
    </div>

    <span
      class="dm-absolute dm-left-[20px] dm-top-[20px] dm-inline-flex dm-items-center dm-rounded-full dm-border dm-border-sale dm-bg-white dm-px-3 dm-py-1.5 dm-text-l dm-leading-none dm-text-sale {% unless on_sale %}dm-hidden{% endunless %}"
      data-sale-badge
    >
      On Sale!
    </span>
  </a>

  <div class="dm-mt-4 dm-flex dm-flex-col dm-gap-4">
    {% render 'domaine-product-card-swatches', product: product, current_variant: current_variant %}

    <div class="dm-flex dm-flex-col dm-gap-1.5">
      {% if brand_label != blank %}
        <p class="dm-text-sm dm-text-ink">{{ brand_label }}</p>
      {% endif %}
      <a
        href="{{ variant_url }}"
        class="dm-text-base dm-font-medium dm-text-brand"
        data-title-link
      >
        {{ product.title }}
      </a>
      <div data-price-wrapper>
        {% render 'domaine-product-card-price', variant: current_variant %}
      </div>
    </div>
  </div>
</domaine-product-card>
